{
  "name": "aiem-connect",
  "version": "1.0.0",
  "description": "AIEM Connect - College Alumni Network Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:deploy": "npm run db:deploy --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "docker:verify": "node scripts/docker-verify/run.mjs",
    "docker:verify:down": "node scripts/docker-verify/run.mjs --down",
    "test:scripts": "node --test scripts/*/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
