# Database (PostgreSQL - required)
# Local dev without Docker: `npm run db:local -w server` (embedded PostgreSQL 17 on :5433), then
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/alumni_connect"
# docker-compose sets this itself (postgresql://<user>:<password>@postgres:5432/<db>)

# Server
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Redis (optional)
REDIS_URL="redis://localhost:6379"
FEED_CACHE_TTL_SECONDS=120

# JWT
# Production requires 32+ random characters for both secrets (server refuses to start otherwise)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay (optional)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Webhook secret (Razorpay Dashboard > Settings > Webhooks). Point the webhook at
#   https://<api-host>/api/payments/webhook/razorpay
# with the events payment.captured, order.paid and payment.failed, using this same secret.
# While unset the webhook endpoint answers 503 and never accepts unsigned events.
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email (SendGrid or SMTP)
SENDGRID_API_KEY="your_sendgrid_api_key"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="noreply@alumniconnect.edu"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="http://localhost:5000/api/auth/linkedin/callback"

# Place search / reverse geocoding for the alumni map (optional)
# Defaults to OpenStreetMap Nominatim (max 1 request/second, results cached server-side).
# Use a self-hosted Nominatim for heavy traffic, or GEOCODER_URL=off to disable place search.
# GEOCODER_URL="https://nominatim.openstreetmap.org"
# GEOCODER_EMAIL="ops@your-domain.edu"   # contact address Nominatim asks for
# GEOCODER_USER_AGENT="AITD-Alumni-Network/1.0 (+https://your-domain.edu)"

# AWS S3 / Cloudflare R2 (optional)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="alumni-connect-uploads"

# Image processing
IMAGE_COMPRESSION_ENABLED=true
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920

# Seeding (prisma/seed.ts). Required in production; sample data is skipped in production unless SEED_SAMPLE_DATA=true
SEED_ADMIN_EMAIL="admin@aitdconnection.edu"
SEED_ADMIN_PASSWORD=""
SEED_SAMPLE_DATA=false
