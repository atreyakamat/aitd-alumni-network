// Prisma Schema for AITD Connection Platform
// This schema defines all database models for the alumni network

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum RoleType {
  STUDENT
  ALUMNI
  FACULTY
}

enum UserRole {
  MEMBER
  CHAPTER_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PostType {
  GENERAL
  JOB
  BUSINESS
  ANNOUNCEMENT
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  VOLUNTEER
  MENTORSHIP
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CLOSED
  REJECTED
}

enum EventType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum GalleryAlbumType {
  EVENT
  BATCH
  INSTITUTIONAL
}

enum NewsCategory {
  EVENT_RECAP
  ALUMNI_STORY
  INSTITUTE_UPDATE
  NEWSLETTER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MarketplaceListingType {
  BUSINESS
  SERVICE
  REQUIREMENT
  FOUNDER
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE_RECEIVED
  POST_LIKED
  POST_COMMENTED
  EVENT_RSVP
  MEMBERSHIP_EXPIRY
  JOB_MATCH
  ADMIN_ANNOUNCEMENT
  MENTION
  MENTORSHIP_REQUEST
  MENTORSHIP_ACCEPTED
  MENTORSHIP_DECLINED
  MENTORSHIP_SESSION
  POST_REACTED
  COMMENT_REPLIED
  COMMENT_REACTED
  POST_REPOSTED
  NEW_FOLLOWER
  CONTENT_REPORTED
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TransactionType {
  MEMBERSHIP
  DONATION
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum VideoStatus {
  PENDING   // submitted by a member/student/alumni, awaiting admin review
  APPROVED  // live on the public Videos page
  REJECTED
}

enum RequirementCategory {
  HARDWARE
  SOFTWARE
  EXPERTISE
  SPONSORSHIP
  OTHER
}

enum RequirementStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LandingBlockType {
  HERO
  TEXT
  IMAGE
  STATS
  CTA
  HTML
}

// ============== MODELS ==============

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?
  fullName          String
  profilePhotoUrl   String?
  coverPhotoUrl     String?
  
  // Academic info
  batchYear         Int
  department        String
  degree            String
  roleType          RoleType  @default(ALUMNI)
  
  // Professional info
  currentDesignation String?
  shortBio          String?   @db.Text
  
  // Location. homeLat/Lng is the residence; workLat/Lng is where the member works.
  // locationLat/Lng is the map pin, DERIVED on save as work-if-set-else-residence, so the
  // alumni map/nearby queries (which read locationLat/Lng) prefer the work location.
  city              String?
  hometown          String?
  locationLat       Decimal?  @db.Decimal(10, 8)
  locationLng       Decimal?  @db.Decimal(11, 8)
  homeLat           Decimal?  @db.Decimal(10, 8)
  homeLng           Decimal?  @db.Decimal(11, 8)
  workCity          String?
  workLat           Decimal?  @db.Decimal(10, 8)
  workLng           Decimal?  @db.Decimal(11, 8)
  isLocationPublic  Boolean   @default(false)
  
  // Contact & Social
  phoneNumber       String?   // Plain text; exposure is governed by phoneVisibility
  phoneVisibility   String    @default("PRIVATE") // PUBLIC, CONNECTIONS, PRIVATE
  linkedinUrl       String?
  twitterUrl        String?
  githubUrl         String?
  websiteUrl        String?
  secondaryEmail    String?
  
  // System
  userRole          UserRole  @default(MEMBER)
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  isNotable         Boolean   @default(false)
  emailVerifiedAt   DateTime?
  profileCompleteness Int     @default(0)
  lastLoginAt       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  digestOptOut      Boolean   @default(false) // unsubscribed from the weekly digest email
  tokenVersion      Int       @default(0) // Bumped to invalidate every issued access token
  
  // Membership
  membershipTierId  String?
  membershipTier    MembershipTier? @relation(fields: [membershipTierId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  workExperiences   WorkExperience[]
  educations        Education[]
  skills            UserSkill[]
  memberships       UserMembership[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  jobOpportunities  JobOpportunity[]
  mentorProfile     MentorProfile?
  mentorRequests    MentorshipRequest[] @relation("Mentee")
  mentorSessions    MentorshipRequest[] @relation("Mentor")
  eventsCreated     Event[]   @relation("EventCreator")
  eventRsvps        EventRSVP[]
  galleryPhotosUploaded GalleryPhoto[]
  newsArticles      NewsArticle[]
  donations         Donation[]
  chapterMemberships ChapterMembership[]
  chaptersAdmin     Chapter[] @relation("ChapterAdmin")
  marketplaceListings MarketplaceListing[]
  messagesSent      Message[] @relation("Sender")
  messagesReceived  Message[] @relation("Receiver")
  connectionsSent   Connection[] @relation("Requester")
  connectionsReceived Connection[] @relation("Addressee")
  notifications     Notification[]
  transactions      Transaction[]
  invitesSent       Invite[]
  refreshTokens     RefreshToken[]
  verificationTokens VerificationToken[]
  following         Follow[]  @relation("Follower")
  followers         Follow[]  @relation("Followed")
  savedPosts        SavedPost[]
  commentReactions  CommentReaction[]
  postMentions      PostMention[]
  commentMentions   CommentMention[]
  postImpressions   PostImpression[]
  reportsFiled      ContentReport[] @relation("ReportsFiled")
  reportsResolved   ContentReport[] @relation("ReportsResolved")
  collegeVideosSubmitted CollegeVideo[]    @relation("CollegeVideosSubmitted")
  collegeVideosReviewed  CollegeVideo[]    @relation("CollegeVideosReviewed")
  collegeMagazines       CollegeMagazine[] @relation("CollegeMagazines")
  requirementsPosted     CollegeRequirement[]  @relation("RequirementsPosted")
  requirementResponses   RequirementResponse[]
  referralsSent          ReferralRequest[] @relation("ReferralRequester")
  referralsReceived      ReferralRequest[] @relation("ReferralTarget")

  @@index([email])
  @@index([batchYear])
  @@index([department])
  @@index([city])
  @@index([isActive])
  @@index([fullName])
  // Bounding-box scans for the alumni map / nearby search (see userService.getNearbyAlumni).
  // locationLat/Lng is the derived map pin, so one index on it still serves every map query.
  @@index([locationLat, locationLng])
}

// Verification tokens for 2FA, email verification, password reset
model VerificationToken {
  id          String    @id @default(uuid())
  token       String
  type        String    // EMAIL_VERIFY, PASSWORD_RESET, TWO_FACTOR
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([type])
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique @db.VarChar(500)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String?  @db.VarChar(36) // Rotation chain; reuse of a rotated token revokes the family
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([familyId])
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
}

model Education {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   String
  degree        String
  fieldOfStudy  String?
  startYear     Int
  endYear       Int?
  grade         String?
  description   String?   @db.Text
  isPrimary     Boolean   @default(false) // Primary = the alumni institution
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
}

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  category  String?
  users     UserSkill[]
  createdAt DateTime    @default(now())
  
  @@index([name])
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ============== MEMBERSHIP ==============

model MembershipTier {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?   @db.Text
  priceInr        Decimal   @db.Decimal(10, 2)
  durationMonths  Int?      // null for lifetime
  benefits        Json      // Array of benefit strings
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0)
  badgeColor      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  users           User[]
  memberships     UserMembership[]
}

model UserMembership {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId        String
  tier          MembershipTier   @relation(fields: [tierId], references: [id])
  startDate     DateTime         @default(now())
  endDate       DateTime?
  status        MembershipStatus @default(ACTIVE)
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  @@index([userId])
  @@index([status])
}

// ============== NOTICE BOARD (SOCIAL FEED) ==============

model Post {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PostType  @default(GENERAL)
  content     String    @db.Text
  mediaUrls   Json?     // Array of image URLs
  videoUrl    String?
  thumbnailUrl String?  // Poster image for videoUrl
  isReel      Boolean   @default(false)
  linkUrl     String?
  visibility  PostVisibility @default(PUBLIC)
  isPinned    Boolean   @default(false)
  isPublished Boolean   @default(true)
  // Reposts are posts: a plain repost has empty content, a quote post has the reposter's text
  isRepost    Boolean   @default(false)
  repostOfId  String?
  repostOf    Post?     @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts     Post[]    @relation("Reposts")
  // "<userId>:<originalId>" on plain reposts only: the unique index allows one plain repost per member
  plainRepostKey String? @unique
  likeCount   Int       @default(0) // all reaction types
  commentCount Int      @default(0)
  repostCount Int       @default(0)
  viewCount   Int       @default(0)
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  likes       PostLike[]
  comments    PostComment[]
  hashtags    PostHashtag[]
  mentions    PostMention[]
  savedBy     SavedPost[]
  impressions PostImpression[]
  reports     ContentReport[]

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([isPinned])
  @@index([isPublished, createdAt])
  @@index([isReel, createdAt])
  @@index([repostOfId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE) // the row is a reaction; the model keeps its v1 name
  createdAt DateTime @default(now())
  
  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  parentId  String?  // Replies are one level deep (see SOCIAL_API.md)
  parent    PostComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  likeCount Int      @default(0) // all reaction types
  editedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions CommentReaction[]
  mentions  CommentMention[]
  reports   ContentReport[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followed", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Hashtag {
  id        String        @id @default(uuid())
  tag       String        @unique // lower-case, without '#'
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt])
}

model PostMention {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model CommentMention {
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// One row per member per post: the deduplicated view count
model PostImpression {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model ContentReport {
  id              String       @id @default(uuid())
  // Exactly one of postId / commentId; SetNull keeps the report after the content is removed
  postId          String?
  post            Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId       String?
  comment         PostComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reporterId      String
  reporter        User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason          ReportReason
  details         String?      @db.Text
  contentSnapshot String?      @db.Text // what the content said when reported
  status          ReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?        @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolution      String?      @db.Text
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
}

// ============== CAREERS ==============

model JobOpportunity {
  id              String        @id @default(uuid())
  postedById      String
  postedBy        User          @relation(fields: [postedById], references: [id], onDelete: Cascade)
  title           String
  description     String        @db.Text
  company         String
  location        String?
  workplaceType   WorkplaceType @default(ONSITE)
  jobType         JobType       @default(FULL_TIME)
  industry        String?
  salaryMin       Decimal?      @db.Decimal(12, 2)
  salaryMax       Decimal?      @db.Decimal(12, 2)
  experienceMin   Int?
  experienceMax   Int?
  skills          Json?         // Array of skill names
  applicationLink String?
  deadline        DateTime?
  status          JobStatus     @default(DRAFT)
  rejectionReason String?       @db.Text
  isFeatured      Boolean       @default(false)
  isOfficial      Boolean       @default(false) // posted by the placement cell / admin
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  referralRequests ReferralRequest[]

  @@index([postedById])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
  @@index([title])
}

model MentorProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreas    Json      // Array of areas
  availability  String?   // Description of availability
  bio           String?   @db.Text
  maxMentees    Int       @default(5)
  currentMentees Int      @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  requests      MentorshipRequest[]
}

model MentorshipRequest {
  id          String    @id @default(uuid())
  menteeId    String
  mentee      User      @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      User      @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  profileId   String
  profile     MentorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  message     String?   @db.Text
  status      String    @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  sessions    MentorshipSession[]
  
  @@index([menteeId])
  @@index([mentorId])
  @@index([status])
}

model MentorshipSession {
  id          String    @id @default(uuid())
  requestId   String
  request     MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  notes       String?   @db.Text
  outcomes    String?   @db.Text
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([requestId])
}

// ============== EVENTS ==============

model Event {
  id            String      @id @default(uuid())
  title         String
  description   String      @db.Text
  bannerUrl     String?
  eventType     EventType   @default(OFFLINE)
  venue         String?
  address       String?
  city          String?
  joinLink      String?
  startDate     DateTime
  endDate       DateTime?
  capacity      Int?
  rsvpCount     Int         @default(0)
  tags          Json?       // Array of tags
  isPublic      Boolean     @default(true)
  status        EventStatus @default(DRAFT)
  chapterId     String?
  chapter       Chapter?    @relation(fields: [chapterId], references: [id])
  createdById   String
  createdBy     User        @relation("EventCreator", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  rsvps         EventRSVP[]
  galleryAlbums GalleryAlbum[]
  
  @@index([startDate])
  @@index([status])
  @@index([chapterId])
}

model EventRSVP {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpAt    DateTime @default(now())
  attended  Boolean  @default(false)
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ============== GALLERY ==============

model GalleryAlbum {
  id            String           @id @default(uuid())
  title         String
  description   String?          @db.Text
  albumType     GalleryAlbumType @default(INSTITUTIONAL)
  batchYear     Int?
  eventId       String?
  event         Event?           @relation(fields: [eventId], references: [id])
  coverPhotoUrl String?
  photoCount    Int              @default(0)
  isPublic      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  photos        GalleryPhoto[]
  
  @@index([albumType])
  @@index([batchYear])
  @@index([eventId])
}

model GalleryPhoto {
  id          String       @id @default(uuid())
  albumId     String
  album       GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  caption     String?
  uploadedById String
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime     @default(now())
  
  @@index([albumId])
}

// ============== NEWS & STORIES ==============

model NewsArticle {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  content       String        @db.Text
  excerpt       String?       @db.Text
  category      NewsCategory  @default(INSTITUTE_UPDATE)
  featuredImage String?
  authorId      String
  author        User          @relation(fields: [authorId], references: [id])
  status        ArticleStatus @default(DRAFT)
  readingTime   Int?          // In minutes
  viewCount     Int           @default(0)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
}

// ============== DONATIONS ==============

model Donation {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  isAnonymous   Boolean   @default(false)
  dedicatedTo   String?   // In memory of / In honor of
  message       String?   @db.Text
  chapterId     String?
  chapter       Chapter?  @relation(fields: [chapterId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  isFeatured    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([chapterId])
  @@index([createdAt])
}

// ============== CHAPTERS ==============

model Chapter {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?   @db.Text
  region          String
  adminUserId     String?
  admin           User?     @relation("ChapterAdmin", fields: [adminUserId], references: [id])
  logoUrl         String?
  memberCount     Int       @default(0)
  totalDonations  Decimal   @default(0) @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  memberships     ChapterMembership[]
  events          Event[]
  donations       Donation[]
  
  @@index([region])
  @@index([isActive])
}

model ChapterMembership {
  id        String   @id @default(uuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  
  @@unique([chapterId, userId])
  @@index([chapterId])
  @@index([userId])
}

// ============== MARKETPLACE ==============

model MarketplaceListing {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        MarketplaceListingType @default(BUSINESS)
  title       String
  category    String
  description String                 @db.Text
  location    String?
  website     String?
  contactInfo String?
  priceRange  String?
  logoUrl     String?                // business/founder logo or headshot
  images      Json?                  // array of showcase image URLs
  isActive    Boolean                @default(true)
  isFeatured  Boolean                @default(false)
  viewCount   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

// ============== MESSAGING ==============

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  mediaUrl    String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  isRequest   Boolean  @default(false) // True if sender is not connected
  requestStatus String? // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ============== NETWORKING ==============

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// ============== NOTIFICATIONS ==============

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?            // Additional data
  createdAt DateTime         @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============== TRANSACTIONS ==============

model Transaction {
  id              String            @id @default(uuid())
  // Null for guest donations (donor details live in metadata) and for records whose
  // user row was hard-deleted: financial records are kept (SetNull), never cascaded away.
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("INR")
  status          TransactionStatus @default(PENDING)
  gatewayOrderId  String?           @unique // Razorpay order ID
  gatewayPaymentId String?          // Razorpay payment ID
  gatewaySignature String?
  receiptUrl      String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  memberships     UserMembership[]
  donations       Donation[]
  
  @@index([userId])
  @@index([status])
  @@index([type])
}

// ============== INVITES ==============

model Invite {
  id          String    @id @default(uuid())
  email       String
  name        String?
  batchYear   Int?
  roleType    RoleType  @default(ALUMNI)
  inviterId   String?
  inviter     User?     @relation(fields: [inviterId], references: [id], onDelete: SetNull)
  token       String    @unique
  status      String    @default("PENDING") // PENDING, SENT, ACCEPTED, EXPIRED
  expiresAt   DateTime
  acceptedAt  DateTime?
  isShareable Boolean   @default(false)
  metadata    Json?     // Custom message, batch year, etc.
  createdAt   DateTime  @default(now())
  
  @@index([email])
  @@index([token])
  @@index([inviterId])
  @@index([status])
}

// ============== COLLEGE VIDEOS ==============

// Admin-managed college videos. Members (students/alumni) may submit videos, which
// enter as PENDING and become visible only once an admin APPROVES them.
model CollegeVideo {
  id              String      @id @default(uuid())
  title           String
  description     String?     @db.Text
  videoUrl        String
  thumbnailUrl    String?
  category        String?     // Campus, Convocation, Lectures, Student Life, ...
  status          VideoStatus @default(PENDING)
  viewCount       Int         @default(0)
  // Who submitted it (member or admin) and the admin who reviewed it
  submittedById   String
  submittedBy     User        @relation("CollegeVideosSubmitted", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedById    String?
  reviewedBy      User?       @relation("CollegeVideosReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([category])
}

// ============== COLLEGE MAGAZINE ==============

// Admin-published magazine editions (a cover image + a PDF).
model CollegeMagazine {
  id            String   @id @default(uuid())
  title         String
  edition       String?  // e.g. "Vol 12 • 2026"
  description   String?  @db.Text
  coverImageUrl String?
  fileUrl       String   // the magazine PDF
  isPublished   Boolean  @default(true)
  uploadedById  String
  uploadedBy    User     @relation("CollegeMagazines", fields: [uploadedById], references: [id], onDelete: Cascade)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ============== COLLEGE REQUIREMENTS ==============

// The college posts a requirement; alumni respond offering to provide/help.
model CollegeRequirement {
  id          String              @id @default(uuid())
  title       String
  description String              @db.Text
  category    RequirementCategory @default(OTHER)
  status      RequirementStatus   @default(OPEN)
  postedById  String
  postedBy    User                @relation("RequirementsPosted", fields: [postedById], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  responses   RequirementResponse[]

  @@index([status, createdAt])
  @@index([category])
}

model RequirementResponse {
  id            String             @id @default(uuid())
  requirementId String
  requirement   CollegeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  message       String             @db.Text
  status        String             @default("OFFERED") // OFFERED, ACCEPTED, DECLINED
  createdAt     DateTime           @default(now())

  @@unique([requirementId, userId]) // one offer per alum per requirement
  @@index([requirementId])
  @@index([userId])
}

// ============== JOB REFERRALS ==============

model ReferralRequest {
  id          String         @id @default(uuid())
  requesterId String
  requester   User           @relation("ReferralRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User           @relation("ReferralTarget", fields: [targetId], references: [id], onDelete: Cascade)
  jobId       String?        // optional: a specific job on the board
  job         JobOpportunity? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company     String
  message     String         @db.Text
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([requesterId, targetId, jobId]) // no duplicate asks for the same job
  @@index([targetId, status])
  @@index([requesterId])
}

// ============== WEEKLY DIGEST ==============

// Single admin-edited row (id = "default") controlling the weekly digest email.
model DigestSettings {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  dayOfWeek Int      @default(1) // 0=Sunday .. 1=Monday
  hour      Int      @default(9) // server local hour, 0-23
  sections  Json     // { nearbyAlumni, jobs, events, videos, requirements } booleans
  lastRunAt DateTime? // last time the weekly send fired (dedupes to once per week)
  updatedAt DateTime @updatedAt
}

// ============== LANDING PAGE BUILDER ==============

model LandingBlock {
  id          String           @id @default(uuid())
  type        LandingBlockType
  config      Json             // per-type fields (title/body/imageUrl/items[] or raw html+css)
  order       Int              @default(0)
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublished, order])
}

// ============== AUDIT LOG ==============

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}
