# TIP: `./start.sh` (or `make up`) auto-generates .env with secrets and starts everything.
#
# docker-compose settings. Copy to `.env` (next to docker-compose.yml) and fill in the REQUIRED values:
#   cp .env.docker.example .env
# Generate every secret below with:  npm run secrets -w server   (printed, never saved)
# BEFORE go-live read docs/PRODUCTION_CHECKLIST.md and run:  npm run preflight -w server -- --env-file ../.env
# With NODE_ENV=production (docker-compose sets it) the API refuses to start on an unsafe configuration.

# ---- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_DB=aiem_connect
POSTGRES_USER=aiem
# REQUIRED
POSTGRES_PASSWORD=change-me-postgres-password
# host port (bound to 127.0.0.1 only)
# POSTGRES_HOST_PORT=5432

# ---- Auth (REQUIRED: 32+ random characters each; the API refuses weak secrets) -------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Production guard ------------------------------------------------------------------------
# Trying the stack on ONE machine without a domain or mail server? Set BOTH lines for that trial only; they turn the
# public-internet checks (https origins, mail server, live payment keys) into warnings and switch e-mail verification
# off. Secret and database-password checks always apply. NEVER set them on a real server.
# ALLOW_INSECURE_PRODUCTION_CONFIG=true
# REQUIRE_EMAIL_VERIFICATION=false
# Access-token lifetime; production default is 15m (the refresh token keeps people signed in)
# JWT_EXPIRES_IN=15m

# ---- First admin (created on first boot; re-runs never reset the password) -----------------
SEED_ADMIN_EMAIL=admin@aiemgoa.ac.in
# REQUIRED for the admin account, 12+ chars
SEED_ADMIN_PASSWORD=
SEED_ON_START=true
# demo users/events/news (not for production)
# SEED_SAMPLE_DATA=true

# ---- URLs ----------------------------------------------------------------------------------
# What browsers use. The localhost defaults below are for a LOCAL TRIAL only (they need the waiver above);
# a real deployment uses https:// addresses (examples further down).
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost
# baked into the web image at build time
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# With the proxy profile on a domain, use e.g.:
#   FRONTEND_URL=https://alumni.example.edu
#   CORS_ORIGINS=https://alumni.example.edu
#   NEXT_PUBLIC_API_URL=https://alumni.example.edu/api
# WEB_HOST_PORT=3000
# API_HOST_PORT=5000
# PROXY_HOST_PORT=80

# ---- Maps (optional; OpenStreetMap by default, no keys needed) ------------------------------
# or a self-hosted Nominatim, or "off"
# GEOCODER_URL=https://nominatim.openstreetmap.org
# contact address Nominatim asks for
# GEOCODER_EMAIL=ops@example.edu
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# ---- Payments (optional) -------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# webhook URL: https://<api-host>/api/payments/webhook/razorpay
# RAZORPAY_WEBHOOK_SECRET=

# ---- Email (REQUIRED in production: sign-up is blocked until the address is verified; without it mails are only logged)
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@aiemgoa.ac.in

# ---- File storage (optional; defaults to the uploads volume) -------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=

# ---- OAuth (optional) ----------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ---- Network exposure and rate limiting -----------------------------------------------------
# The API port is bound to 127.0.0.1 (reach it through the nginx `proxy` profile or your own TLS proxy).
# API_BIND=0.0.0.0
# How many reverse proxies sit in front of the API. 1 = nginx / one load balancer, 2 = e.g. Cloudflare + nginx,
# 0 = the API is exposed directly (then also set API_BIND=0.0.0.0). A wrong value either lets clients spoof
# X-Forwarded-For to dodge rate limits (too high) or puts every visitor in one shared bucket (too low).
# TRUST_PROXY=1
