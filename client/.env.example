# API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# API URL for server-side rendering only (e.g. event SEO metadata), read at runtime.
# Set it when the browser-facing URL is not reachable from the web server, e.g.
# http://api:5000/api in docker-compose. Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Alumni map tiles (optional). Defaults to the public OpenStreetMap tile server, which is
# fine for light use; for production traffic point this at your own or a commercial
# OSM tile provider (see https://operations.osmfoundation.org/policies/tiles/).
# Read at build time: rebuild the web image after changing them.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# LinkedIn OAuth (optional)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# Public contact address shown on /contact (optional; defaults to contact@aitdconnection.aitd.edu)
NEXT_PUBLIC_CONTACT_EMAIL=
